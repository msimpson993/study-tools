{
  "$id": "graph.schema.json",
  "type": "object",
  "required": [
    "maps"
  ],
  "additionalProperties": false,
  "properties": {
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "short"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "box",
                    "decision",
                    "terminal"
                  ]
                },
                "series": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "short": {
                  "type": "string",
                  "minLength": 20
                },
                "eq": {
                  "type": "string"
                },
                "eqTex": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "recognize": {
                  "type": "string"
                },
                "trap": {
                  "type": "string"
                },
                "predict": {
                  "type": "string"
                },
                "dive": {
                  "type": "string"
                },
                "live": {
                  "type": "string",
                  "pattern": "^(figure|board):[A-Za-z0-9_-]+(\\?.*)?$"
                },
                "quizTag": {
                  "type": "string"
                },
                "link": {
                  "type": "object",
                  "required": [
                    "href",
                    "label"
                  ],
                  "properties": {
                    "href": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "addsToExample": {
                  "type": "string",
                  "minLength": 15,
                  "description": "What this box adds to the subject's running example."
                },
                "accountsFor": {
                  "type": "string",
                  "minLength": 10,
                  "description": "What this box lets us account for (a behaviour of the example we could not explain before)."
                },
                "exampleScene": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Pick the overlays of the subject's example scene that this node adds (see docs/components.md, example scenes). Names are validated against the scene's catalogue at build time.",
                  "properties": {
                    "scene": {
                      "type": "string",
                      "description": "Draw another scene of the subject than runningExample.scene (it must be runningExample.scene.id or one of runningExample.moreScenes)."
                    },
                    "overlays": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "description": "Overlay ids, e.g. [forces, phase]. At most two small panels may open."
                    },
                    "caption": {
                      "type": "string",
                      "description": "One line under the picture."
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Closed-loop cart parameters (numbers): K, Ki, Kd, r, umax, d, td, noise, seed, delay, lag. Only valid with a closed-loop overlay (loop, pid, disturb, noise, limit, delay, lag); ranges are in docs/example-scenes.md and checked at build time."
                    },
                    "diagram": {
                      "description": "Staged block diagram under the picture: a stage name or a list of stages (cart: ode, open, poles, states, loop, error, disturb, pid, noise, gain, sfb, observer, sep, refin; speaker: spk-chain, spk-model, spk-digital, anc-ff, anc-fb, anc-hybrid; house: house-open, house-modal, house-kalman, house-loop; validated against the scene at build time). Newly added parts at each stage are highlighted. See docs/example-scenes.md.",
                      "oneOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ode",
                            "open",
                            "poles",
                            "states",
                            "loop",
                            "error",
                            "disturb",
                            "pid",
                            "noise",
                            "gain",
                            "sfb",
                            "observer",
                            "sep",
                            "refin",
                            "spk-chain",
                            "spk-model",
                            "spk-digital",
                            "anc-ff",
                            "anc-fb",
                            "anc-hybrid",
                            "house-open",
                            "house-modal",
                            "house-kalman",
                            "house-loop"
                          ]
                        },
                        {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "enum": [
                              "ode",
                              "open",
                              "poles",
                              "states",
                              "loop",
                              "error",
                              "disturb",
                              "pid",
                              "noise",
                              "gain",
                              "sfb",
                              "observer",
                              "sep",
                              "refin",
                              "spk-chain",
                              "spk-model",
                              "spk-digital",
                              "anc-ff",
                              "anc-fb",
                              "anc-hybrid",
                              "house-open",
                              "house-modal",
                              "house-kalman",
                              "house-loop"
                            ]
                          }
                        }
                      ]
                    }
                  }
                },
                "pop": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rough"
                  ],
                  "description": "Opt-in fixed pop-up template: the short answer, then a rough-words formula, optional figures (quiz-figure renderers, drawn as one compact strip), the running-example line, the next question and one intuition question (a quiz id). When present the pop-up shows only this template.",
                  "properties": {
                    "rough": {
                      "type": "string",
                      "minLength": 8,
                      "description": "the formula in rough words"
                    },
                    "eqKey": {
                      "type": "string",
                      "description": "what each symbol of `eq` means and what the equation is used for"
                    },
                    "figures": {
                      "type": "array",
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "alt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "params": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "number",
                                "string",
                                "boolean"
                              ]
                            }
                          },
                          "alt": {
                            "type": "string",
                            "minLength": 8
                          },
                          "caption": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "figCaption": {
                      "type": "string",
                      "minLength": 20,
                      "description": "HTML caption under the figure strip: what each panel shows and what it demonstrates, walking through panels (a), (b)… in order"
                    },
                    "example": {
                      "type": "string",
                      "minLength": 10,
                      "description": "'On the running example:' line (default: addsToExample)"
                    },
                    "next": {
                      "type": "string",
                      "minLength": 8,
                      "description": "'Next question:' (the outgoing edge question)"
                    },
                    "ask": {
                      "type": "string",
                      "description": "quiz id of the one intuition question"
                    },
                    "audio": {
                      "type": "array",
                      "description": "opt-in sound players (ids from subject.yaml audio)",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]+$"
                      }
                    }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "question",
                "idea"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "dashed": {
                  "type": "boolean"
                },
                "question": {
                  "type": "string",
                  "minLength": 8
                },
                "idea": {
                  "type": "string",
                  "minLength": 20
                },
                "why": {
                  "type": "string",
                  "minLength": 20,
                  "description": "why you would ask this question at this point (markdown, may be several paragraphs): what the previous box left unanswered, why that gap matters, and what kind of answer we are looking for"
                },
                "whyFigures": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "alt"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "params": {
                        "type": "object",
                        "additionalProperties": {
                          "type": [
                            "number",
                            "string",
                            "boolean"
                          ]
                        }
                      },
                      "alt": {
                        "type": "string",
                        "minLength": 8
                      },
                      "caption": {
                        "type": "string"
                      }
                    }
                  }
                },
                "whyFigCaption": {
                  "type": "string",
                  "minLength": 20
                },
                "eq": {
                  "type": "string"
                },
                "reverse": {
                  "type": "boolean",
                  "description": "draw the arrowhead at the `from` end (a back-reference that the DAG layout lays out downwards)"
                }
              }
            }
          },
          "seriesNames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 48
            },
            "description": "Names of the colour families (node.series 0..4), in order. Shown in the map legend as chips; tapping a chip highlights that group. Warn if nodes use `series` and this is missing."
          }
        }
      }
    }
  }
}
