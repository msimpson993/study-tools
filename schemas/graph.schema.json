{
  "$id": "graph.schema.json",
  "type": "object",
  "required": [
    "maps"
  ],
  "additionalProperties": false,
  "properties": {
    "maps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "nodes",
          "edges"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string"
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label",
                "short"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "box",
                    "decision",
                    "terminal"
                  ]
                },
                "series": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3
                },
                "short": {
                  "type": "string",
                  "minLength": 20
                },
                "eq": {
                  "type": "string"
                },
                "eqTex": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                },
                "recognize": {
                  "type": "string"
                },
                "trap": {
                  "type": "string"
                },
                "predict": {
                  "type": "string"
                },
                "dive": {
                  "type": "string"
                },
                "live": {
                  "type": "string",
                  "pattern": "^(figure|board):[A-Za-z0-9_-]+(\\?.*)?$"
                },
                "quizTag": {
                  "type": "string"
                },
                "link": {
                  "type": "object",
                  "required": [
                    "href",
                    "label"
                  ],
                  "properties": {
                    "href": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "addsToExample": {
                  "type": "string",
                  "minLength": 15,
                  "description": "What this box adds to the subject's running example."
                },
                "accountsFor": {
                  "type": "string",
                  "minLength": 10,
                  "description": "What this box lets us account for (a behaviour of the example we could not explain before)."
                },
                "exampleScene": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Pick the overlays of the subject's example scene that this node adds (see docs/components.md, example scenes). Names are validated against the scene's catalogue at build time.",
                  "properties": {
                    "overlays": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "minItems": 1,
                      "description": "Overlay ids, e.g. [forces, phase]. At most two small panels may open."
                    },
                    "caption": {
                      "type": "string",
                      "description": "One line under the picture."
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      },
                      "description": "Closed-loop cart parameters (numbers): K, Ki, Kd, r, umax, d, td, noise, seed, delay, lag. Only valid with a closed-loop overlay (loop, pid, disturb, noise, limit, delay, lag); ranges are in docs/example-scenes.md and checked at build time."
                    }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "question",
                "idea"
              ],
              "additionalProperties": false,
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "dashed": {
                  "type": "boolean"
                },
                "question": {
                  "type": "string",
                  "minLength": 8
                },
                "idea": {
                  "type": "string",
                  "minLength": 20
                },
                "eq": {
                  "type": "string"
                }
              }
            }
          },
          "seriesNames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 3,
              "maxLength": 48
            },
            "description": "Names of the colour families (node.series 0..3), in order. Shown in the map legend as chips; tapping a chip highlights that group. Warn if nodes use `series` and this is missing."
          }
        }
      }
    }
  }
}
