{
  "$id": "subject.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "centralQuestion",
    "blurb",
    "archetype",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "centralQuestion": {
      "type": "string",
      "minLength": 10
    },
    "blurb": {
      "type": "string",
      "minLength": 10
    },
    "quizFigures": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
      "uniqueItems": true
    },
    "archetype": {
      "enum": [
        "guide",
        "overview"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "map",
              "dives",
              "md",
              "quiz",
              "board",
              "glossary",
              "figures"
            ]
          },
          "file": {
            "type": "string"
          }
        }
      }
    },
    "hub": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": [
        "pairs"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "description": "Porting guard: counts that must match after a migration. Build fails if content drifts.",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "edges": {
          "type": "integer"
        },
        "dives": {
          "type": "integer"
        },
        "quiz": {
          "type": "integer"
        },
        "maps": {
          "type": "integer"
        },
        "examples": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "runningExample": {
      "type": "object",
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false,
      "description": "The one concrete example threaded through the whole subject. Every non-root map node must say what it adds to it.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 30,
          "description": "What the example is, physically, in 1-3 sentences (inline markdown)."
        },
        "details": {
          "type": "string",
          "description": "Optional longer markdown (states, inputs, outputs, numbers)."
        }
      }
    }
  }
}