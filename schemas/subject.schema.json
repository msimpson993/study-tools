{
  "$id": "subject.schema.json",
  "type": "object",
  "required": ["id", "title", "centralQuestion", "blurb", "archetype", "sections"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 3 },
    "centralQuestion": { "type": "string", "minLength": 10 },
    "blurb": { "type": "string", "minLength": 10 },
    "archetype": { "enum": ["guide", "overview"] },
    "categories": { "type": "array", "items": { "type": "object", "required": ["id", "label"], "properties": { "id": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false } },
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "kind"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["map", "dives", "md", "quiz", "board", "glossary", "figures"] },
          "file": { "type": "string" }
        }
      }
    },
    "hub": { "type": "object", "properties": { "order": { "type": "number" } }, "additionalProperties": false },
    "board": { "type": "object", "required": ["pairs"], "properties": { "pairs": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "expect": {
      "description": "Porting guard: counts that must match after a migration. Build fails if content drifts.",
      "type": "object",
      "properties": { "nodes": { "type": "integer" }, "edges": { "type": "integer" }, "dives": { "type": "integer" }, "quiz": { "type": "integer" }, "maps": { "type": "integer" }, "examples": { "type": "integer" } },
      "additionalProperties": false
    }
  }
}
