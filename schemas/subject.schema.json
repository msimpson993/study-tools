{
  "$id": "subject.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "centralQuestion",
    "blurb",
    "archetype",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "quizSets": {
      "type": "array",
      "description": "practice sets that belong to no box: kept off the map, labelled on their quiz cards",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "tag": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "quizOrder": {
      "enum": [
        "authored",
        "chain"
      ],
      "description": "chain: the quiz runs in map order (box 1's questions first, each box's quick check leading), so it opens on an easy foundational question"
    },
    "centralQuestion": {
      "type": "string",
      "minLength": 10
    },
    "blurb": {
      "type": "string",
      "minLength": 10
    },
    "quizFigures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true
    },
    "archetype": {
      "enum": [
        "guide",
        "overview"
      ]
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "map",
              "dives",
              "md",
              "quiz",
              "board",
              "glossary",
              "figures",
              "review"
            ]
          },
          "file": {
            "type": "string"
          }
        }
      }
    },
    "hub": {
      "type": "object",
      "properties": {
        "order": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "required": [
        "pairs"
      ],
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "expect": {
      "description": "Porting guard: counts that must match after a migration. Build fails if content drifts.",
      "type": "object",
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "edges": {
          "type": "integer"
        },
        "dives": {
          "type": "integer"
        },
        "quiz": {
          "type": "integer"
        },
        "maps": {
          "type": "integer"
        },
        "examples": {
          "type": "integer"
        },
        "review": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "runningExample": {
      "type": "object",
      "required": [
        "title",
        "summary"
      ],
      "additionalProperties": false,
      "description": "The one concrete example threaded through the whole subject. Every non-root map node must say what it adds to it.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "summary": {
          "type": "string",
          "minLength": 30,
          "description": "What the example is, physically, in 1-3 sentences (inline markdown)."
        },
        "details": {
          "type": "string",
          "description": "Optional longer markdown (states, inputs, outputs, numbers)."
        },
        "scene": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "description": "Which core example scene draws this running example (cart, tine) and, optionally, the overlays of the small hero picture on the map page.",
          "properties": {
            "id": {
              "type": "string"
            },
            "overlays": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "params": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              },
              "description": "Closed-loop cart parameters (numbers): K, Ki, Kd, r, umax, d, td, noise, seed, delay, lag. Only valid with a closed-loop overlay (loop, pid, disturb, noise, limit, delay, lag); ranges are in docs/example-scenes.md and checked at build time."
            },
            "diagram": {
              "description": "Staged block diagram under the picture: a stage name or a list of stages (cart: ode, open, poles, states, loop, error, disturb, pid, noise, gain, sfb, observer, sep, refin; speaker: spk-chain, spk-model, spk-digital, anc-ff, anc-fb, anc-hybrid; house: house-open, house-modal, house-kalman, house-loop; validated against the scene at build time). Newly added parts at each stage are highlighted. See docs/example-scenes.md.",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "ode",
                    "open",
                    "poles",
                    "states",
                    "loop",
                    "error",
                    "disturb",
                    "pid",
                    "noise",
                    "gain",
                    "sfb",
                    "observer",
                    "sep",
                    "refin",
                    "spk-chain",
                    "spk-model",
                    "spk-digital",
                    "anc-ff",
                    "anc-fb",
                    "anc-hybrid",
                    "house-open",
                    "house-modal",
                    "house-kalman",
                    "house-loop"
                  ]
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": [
                      "ode",
                      "open",
                      "poles",
                      "states",
                      "loop",
                      "error",
                      "disturb",
                      "pid",
                      "noise",
                      "gain",
                      "sfb",
                      "observer",
                      "sep",
                      "refin",
                      "spk-chain",
                      "spk-model",
                      "spk-digital",
                      "anc-ff",
                      "anc-fb",
                      "anc-hybrid",
                      "house-open",
                      "house-modal",
                      "house-kalman",
                      "house-loop"
                    ]
                  }
                }
              ]
            },
            "caption": {
              "type": "string",
              "description": "One line under the small hero picture on the map page."
            },
            "title": {
              "type": "string",
              "description": "Short name for the hero switch and the dive callout when there are moreScenes, e.g. 'Earbud speaker'."
            }
          }
        },
        "moreScenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "description": "Further scenes of the same subject (for subjects with more than one running example). The map hero gets a switch between them; dives and nodes pick one with exampleScene.scene.",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "description": "Which core example scene draws this running example (cart, tine) and, optionally, the overlays of the small hero picture on the map page.",
            "properties": {
              "id": {
                "type": "string"
              },
              "overlays": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "params": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                },
                "description": "Closed-loop cart parameters (numbers): K, Ki, Kd, r, umax, d, td, noise, seed, delay, lag. Only valid with a closed-loop overlay (loop, pid, disturb, noise, limit, delay, lag); ranges are in docs/example-scenes.md and checked at build time."
              },
              "diagram": {
                "description": "Staged block diagram under the picture: a stage name or a list of stages (cart: ode, open, poles, states, loop, error, disturb, pid, noise, gain, sfb, observer, sep, refin; speaker: spk-chain, spk-model, spk-digital, anc-ff, anc-fb, anc-hybrid; house: house-open, house-modal, house-kalman, house-loop; validated against the scene at build time). Newly added parts at each stage are highlighted. See docs/example-scenes.md.",
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "ode",
                      "open",
                      "poles",
                      "states",
                      "loop",
                      "error",
                      "disturb",
                      "pid",
                      "noise",
                      "gain",
                      "sfb",
                      "observer",
                      "sep",
                      "refin",
                      "spk-chain",
                      "spk-model",
                      "spk-digital",
                      "anc-ff",
                      "anc-fb",
                      "anc-hybrid",
                      "house-open",
                      "house-modal",
                      "house-kalman",
                      "house-loop"
                    ]
                  },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "ode",
                        "open",
                        "poles",
                        "states",
                        "loop",
                        "error",
                        "disturb",
                        "pid",
                        "noise",
                        "gain",
                        "sfb",
                        "observer",
                        "sep",
                        "refin",
                        "spk-chain",
                        "spk-model",
                        "spk-digital",
                        "anc-ff",
                        "anc-fb",
                        "anc-hybrid",
                        "house-open",
                        "house-modal",
                        "house-kalman",
                        "house-loop"
                      ]
                    }
                  }
                ]
              },
              "caption": {
                "type": "string",
                "description": "One line under the small hero picture on the map page."
              },
              "title": {
                "type": "string",
                "description": "Short name on the hero switch."
              }
            }
          }
        },
        "refs": {
          "type": "array",
          "description": "Example nodes on the map: each running example is its own dashed node beside the box where it first appears (a side column), joined to it by a plain dotted link (no arrow, no label, not clickable). Its pop-up is the example's introduction: the restated question, the live scene (or figure), 'What it is and why we use it' bullets and the key numbers the path has introduced by then. Not part of the Next/Back chain.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "at",
              "label",
              "title",
              "about",
              "numbers"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "at": {
                "type": "string",
                "description": "host box (node id)"
              },
              "label": {
                "type": "string",
                "minLength": 3,
                "maxLength": 28,
                "description": "shown on the Example node"
              },
              "title": {
                "type": "string",
                "minLength": 3
              },
              "scene": {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "description": "Which core example scene draws this running example (cart, tine) and, optionally, the overlays of the small hero picture on the map page.",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "overlays": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "params": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number"
                    },
                    "description": "Closed-loop cart parameters (numbers): K, Ki, Kd, r, umax, d, td, noise, seed, delay, lag. Only valid with a closed-loop overlay (loop, pid, disturb, noise, limit, delay, lag); ranges are in docs/example-scenes.md and checked at build time."
                  },
                  "diagram": {
                    "description": "Staged block diagram under the picture: a stage name or a list of stages (cart: ode, open, poles, states, loop, error, disturb, pid, noise, gain, sfb, observer, sep, refin; speaker: spk-chain, spk-model, spk-digital, anc-ff, anc-fb, anc-hybrid; house: house-open, house-modal, house-kalman, house-loop; validated against the scene at build time). Newly added parts at each stage are highlighted. See docs/example-scenes.md.",
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "ode",
                          "open",
                          "poles",
                          "states",
                          "loop",
                          "error",
                          "disturb",
                          "pid",
                          "noise",
                          "gain",
                          "sfb",
                          "observer",
                          "sep",
                          "refin",
                          "spk-chain",
                          "spk-model",
                          "spk-digital",
                          "anc-ff",
                          "anc-fb",
                          "anc-hybrid",
                          "house-open",
                          "house-modal",
                          "house-kalman",
                          "house-loop"
                        ]
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "enum": [
                            "ode",
                            "open",
                            "poles",
                            "states",
                            "loop",
                            "error",
                            "disturb",
                            "pid",
                            "noise",
                            "gain",
                            "sfb",
                            "observer",
                            "sep",
                            "refin",
                            "spk-chain",
                            "spk-model",
                            "spk-digital",
                            "anc-ff",
                            "anc-fb",
                            "anc-hybrid",
                            "house-open",
                            "house-modal",
                            "house-kalman",
                            "house-loop"
                          ]
                        }
                      }
                    ]
                  },
                  "caption": {
                    "type": "string",
                    "description": "One line under the small hero picture on the map page."
                  },
                  "title": {
                    "type": "string",
                    "description": "Short name for the hero switch and the dive callout when there are moreScenes, e.g. 'Earbud speaker'."
                  }
                }
              },
              "figure": {
                "type": "string",
                "description": "a figures.yaml id (live figure) instead of a scene"
              },
              "preset": {
                "type": "string"
              },
              "question": {
                "type": "string",
                "minLength": 5,
                "description": "the restated question at the top of the pop-up (default: What's the running example?)"
              },
              "about": {
                "type": "string",
                "minLength": 20,
                "description": "What it is and why we use it: a few markdown bullets (in, out, why it's a good example)"
              },
              "numbers": {
                "type": "string",
                "minLength": 10,
                "description": "Key numbers: markdown bullets, ONLY numbers the path has introduced by the host box (no circularity)"
              },
              "panels": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "description": "a figure's panels to show (the animated picture); the introduction never shows the figure's controls or 'Look for'"
              },
              "caption": {
                "type": "string",
                "description": "the caption under a figure (a scene brings its own)"
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "array",
      "description": "opt-in sound examples this app registers (audio.ts); pop.audio ids are validated against it",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "glossaryTopics": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Which glossary section the Variables drawer opens at for a box (node id → glossary section). A box without an entry uses its nearest main-path ancestor's; with none, the drawer guesses from the open text."
    }
  }
}
