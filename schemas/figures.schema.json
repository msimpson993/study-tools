{
  "$id": "figures.schema.json",
  "type": "array",
  "items": {
    "type": "object", "required": ["id", "title", "x", "y", "legend", "howToRead", "controls", "presets"], "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
      "title": { "type": "string" },
      "x": { "type": "string", "minLength": 2, "description": "x-axis name and units" },
      "y": { "type": "string", "minLength": 2, "description": "y-axis name and units" },
      "legend": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["label", "color"], "properties": { "label": { "type": "string" }, "color": { "type": "string" }, "dash": { "type": "boolean" } }, "additionalProperties": false } },
      "howToRead": { "type": "string", "minLength": 20 },
      "controls": {
        "type": "array",
        "items": {
          "type": "object", "required": ["id", "label", "type", "default", "group"], "additionalProperties": false,
          "properties": {
            "id": { "type": "string" }, "label": { "type": "string" }, "type": { "enum": ["range", "select", "seg", "toggle"] },
            "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" },
            "options": { "type": "array", "items": { "type": "object", "required": ["value", "label"], "properties": { "value": { "type": "string" }, "label": { "type": "string" } }, "additionalProperties": false } },
            "default": {}, "group": { "enum": ["primary", "more"] }, "unit": { "type": "string" }
          }
        }
      },
      "presets": { "type": "array", "items": { "type": "object", "required": ["id", "label", "set"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "set": { "type": "object" }, "about": { "type": "string" } }, "additionalProperties": false } },
      "pair": { "type": "object", "required": ["forward", "inverse", "forwardName", "inverseName"], "properties": { "forward": { "type": "string" }, "inverse": { "type": "string" }, "forwardName": { "type": "string" }, "inverseName": { "type": "string" }, "strip": { "type": "string" } }, "additionalProperties": false }
    }
  }
}
