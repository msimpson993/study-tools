{
  "$id": "dive.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "neighbors"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "chain": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Optional 'Where are we?' chain shown above the dive. Leave it out when the dive's opening paragraph names its map question and parent box."
    },
    "neighbors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matlab": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "addsToExample": {
      "type": "string",
      "minLength": 15
    },
    "accountsFor": {
      "type": "string",
      "minLength": 10
    },
    "exampleScene": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pick the overlays of the subject's example scene that this node adds (see docs/components.md, example scenes). Names are validated against the scene's catalogue at build time.",
      "properties": {
        "scene": {
          "type": "string",
          "description": "Draw another scene of the subject than runningExample.scene (it must be runningExample.scene.id or one of runningExample.moreScenes)."
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Overlay ids, e.g. [forces, phase]. At most two small panels may open."
        },
        "caption": {
          "type": "string",
          "description": "One line under the picture."
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "Closed-loop cart parameters (numbers): K, Ki, Kd, r, umax, d, td, noise, seed, delay, lag. Only valid with a closed-loop overlay (loop, pid, disturb, noise, limit, delay, lag); ranges are in docs/example-scenes.md and checked at build time."
        },
        "diagram": {
          "description": "Staged block diagram under the picture: a stage name or a list of stages (cart: ode, open, poles, states, loop, error, disturb, pid, noise, gain, sfb, observer, sep, refin; speaker: spk-chain, spk-model, spk-digital, anc-ff, anc-fb, anc-hybrid; house: house-open, house-modal, house-kalman, house-loop; validated against the scene at build time). Newly added parts at each stage are highlighted. See docs/example-scenes.md.",
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "ode",
                "open",
                "poles",
                "states",
                "loop",
                "error",
                "disturb",
                "pid",
                "noise",
                "gain",
                "sfb",
                "observer",
                "sep",
                "refin",
                "spk-chain",
                "spk-model",
                "spk-digital",
                "anc-ff",
                "anc-fb",
                "anc-hybrid",
                "house-open",
                "house-modal",
                "house-kalman",
                "house-loop"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "enum": [
                  "ode",
                  "open",
                  "poles",
                  "states",
                  "loop",
                  "error",
                  "disturb",
                  "pid",
                  "noise",
                  "gain",
                  "sfb",
                  "observer",
                  "sep",
                  "refin",
                  "spk-chain",
                  "spk-model",
                  "spk-digital",
                  "anc-ff",
                  "anc-fb",
                  "anc-hybrid",
                  "house-open",
                  "house-modal",
                  "house-kalman",
                  "house-loop"
                ]
              }
            }
          ]
        }
      }
    }
  }
}
