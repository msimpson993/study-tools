{
  "$id": "dive.schema.json",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "chain",
    "neighbors"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "chain": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "neighbors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matlab": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "addsToExample": {
      "type": "string",
      "minLength": 15
    },
    "accountsFor": {
      "type": "string",
      "minLength": 10
    },
    "exampleScene": {
      "type": "object",
      "additionalProperties": false,
      "description": "Pick the overlays of the subject's example scene that this node adds (see docs/components.md, example scenes). Names are validated against the scene's catalogue at build time.",
      "properties": {
        "overlays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "Overlay ids, e.g. [forces, phase]. At most two small panels may open."
        },
        "caption": {
          "type": "string",
          "description": "One line under the picture."
        }
      }
    }
  }
}
