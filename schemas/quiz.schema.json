{
  "$id": "quiz.schema.json",
  "type": "array",
  "items": {
    "type": "object", "required": ["id", "tags", "kind", "q"], "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
      "tags": { "type": "array", "minItems": 1, "items": { "type": "string" } },
      "kind": { "enum": ["recall", "recognize", "action", "compute", "trap"] },
      "q": { "type": "string", "minLength": 8 },
      "choices": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "minLength": 1 } },
      "answer": { "type": "integer", "minimum": 0 },
      "a": { "type": "string" },
      "why": { "type": "string" }
    },
    "allOf": [
      { "if": { "properties": { "kind": { "const": "recall" } } },
        "then": { "required": ["a"] },
        "else": { "required": ["choices", "answer", "why"] } }
    ]
  }
}
