{
  "name": "study-tools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Map-first interactive study pages (monorepo): shared core + one app per subject.",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "validate": "tsx scripts/validate-content.ts",
    "build": "tsx scripts/build-all.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "FULL_PAIRWISE=1 playwright test tests/e2e/transforms.spec.ts",
    "shots": "playwright test tests/e2e/shots.spec.ts",
    "serve": "tsx scripts/serve.ts",
    "check": "npm run validate && npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-texmath": "^1.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.0",
    "yaml": "^2.8.0"
  }
}
